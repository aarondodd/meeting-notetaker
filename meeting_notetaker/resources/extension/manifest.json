{
  "manifest_version": 3,
  "name": "Meeting Notetaker Synthesis Bridge",
  "version": "0.7.11",
  "description": "Drives Claude.ai (and later M365 Copilot) for Meeting Notetaker so the synthesis copy/paste step is one click. The browser stays the intermediary -- no audio or transcript bypasses the LLM chat window.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Meeting Notetaker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "alarms",
    "clipboardRead"
  ],
  "host_permissions": [
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://m365.cloud.microsoft/*",
    "*://copilot.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://claude.ai/*", "*://*.claude.ai/*"],
      "js": ["content/common.js", "content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://m365.cloud.microsoft/*", "*://copilot.microsoft.com/*"],
      "js": ["content/common.js", "content/copilot.js"],
      "run_at": "document_idle"
    }
  ]
}
