{
  "manifest_version": 3,
  "name": "MN OWA Calendar Probe",
  "version": "0.0.1",
  "description": "EXPERIMENTAL: reads OWA's internal calendar API (/owa/0/api/v2.0/me/*) and forwards results to a local relay app. Not part of the production Meeting Notetaker install. Issue #69 Option C.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MN OWA Probe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://outlook.office.com/*",
    "*://outlook.office365.com/*",
    "*://outlook.cloud.microsoft/*",
    "*://graph.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://outlook.cloud.microsoft/*"
      ],
      "js": ["content/common.js", "content/owa-probe.js"],
      "run_at": "document_idle"
    }
  ]
}
